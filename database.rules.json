{
  "rules": {
    ".read": false,
    ".write": false,
    
    "system": {
      "admins": {
        ".read": "auth != null",
        ".write": "root.child('system/admins/' + auth.uid).child('status').val() === 'active'"
      },
      "config": {
        ".read": "auth != null",
        ".write": "root.child('system/admins/' + auth.uid).child('status').val() === 'active'"
      }
    },
    
    "userProfiles": {
      ".read": "auth != null && root.child('system/admins/' + auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('system/admins/' + auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName']) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 120",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeenAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    
    "orgs": {
      "$orgId": {
        "members": {
          ".read": "auth != null && root.child('system/admins/' + auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('system/admins/' + auth.uid).exists())",
            ".write": "auth != null && root.child('system/admins/' + auth.uid).child('status').val() === 'active'",
            ".validate": "newData.hasChildren(['role', 'status'])",
            "role": {
              ".validate": "newData.isString()"
            },
            "status": {
              ".validate": "newData.isString()"
            },
            "assignedBy": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "assignedAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        
        "projectIndex": {
          ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && (root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner' || root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee')))",
          ".indexOn": ["updatedAt", "workflowStatus", "dueDate"],
          "$projectId": {
            ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))",
            ".validate": "newData.hasChildren(['id', 'name', 'workflowStatus', 'updatedAt']) && newData.child('id').val() === $projectId",
            "id": {
              ".validate": "newData.isString() && newData.val() === $projectId"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 240"
            },
            "customerDisplayName": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "workflowStatus": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "dueDate": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "schemaVersion": {
              ".validate": "newData.isNumber()"
            },
            "workflowUpdatedAt": {
              ".validate": "newData.isNumber()",
              ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee'))"
            },
            "isTrashed": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        
        "projectPublic": {
          "$projectId": {
            ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && (root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner' || root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee')))",
            ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))",
            ".validate": "newData.hasChildren(['id','name']) && newData.child('id').val() === $projectId",
            "id": {
              ".validate": "newData.isString() && newData.val() === $projectId"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 240"
            },
            "description": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "customerDisplayName": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "dueDate": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "workflowStatus": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        
        "projectFinancials": {
          "$projectId": {
            ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))",
            ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))"
          }
        },
        
        "workflowStaff": {
          "$projectId": {
            ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && (root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner' || root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee')))",
            ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))",
            "items": {
              "$itemId": {
                ".validate": "newData.hasChildren(['name','status'])",
                ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || ((root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner')) || ((root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee') && root.child('orgs').child($orgId).child('projectIndex').child($projectId).exists()))",
                "name": {
                  ".validate": "newData.isString() && newData.val().length <= 240"
                },
                "status": {
                  ".validate": "newData.isString()"
                },
                "updatedAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "stages": {
              "$stageId": {
                ".validate": "newData.hasChildren(['name'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length <= 120"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        
        "ledger": {
          ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))",
          ".indexOn": ["d", "pid", "date", "projectId"],
          "$recordId": {
            ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))"
          }
        },
        
        "receipts": {
          ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))",
          "$receiptId": {
            ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))"
          }
        },
        
        "customerProjectIndex": {
          "$uid": {
            ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || (auth.uid === $uid && root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'customer'))"
          }
        },
        
        "customerViews": {
          "$uid": {
            "$projectId": {
              ".read": "auth != null && ((root.child('system/admins/' + auth.uid).exists()) || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || (auth.uid === $uid && root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'customer' && root.child('orgs').child($orgId).child('customerProjectIndex').child($uid).child($projectId).exists()))",
              ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))"
            }
          }
        },
        
        "customerIntakes": {
          "$uid": {
            ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || (auth.uid === $uid && root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'customer'))"
          }
        },
        
        "projectInvites": {
          ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner'))"
        },
        
        "mediaMetadata": {
          "staff": {
            "$projectId": {
              "$mediaId": {
                ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee'))",
                ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || ((root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee') && root.child('orgs').child($orgId).child('projectIndex').child($projectId).exists() && (!data.exists() || data.child('createdBy').val() === auth.uid)))"
              }
            }
          }
        },
        
        "mediaThumbnails": {
          "staff": {
            "$projectId": {
              "$mediaId": {
                ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee'))",
                ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || ((root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee') && root.child('orgs').child($orgId).child('mediaMetadata').child('staff').child($projectId).child($mediaId).exists() && root.child('orgs').child($orgId).child('mediaMetadata').child('staff').child($projectId).child($mediaId).child('createdBy').val() === auth.uid))"
              }
            }
          }
        },
        
        "mediaPayloads": {
          "staff": {
            "$projectId": {
              "$mediaId": {
                ".read": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee'))",
                ".write": "auth != null && (root.child('system/admins/' + auth.uid).exists() || (root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'partner') || ((root.child('orgs').child($orgId).child('members').child(auth.uid).child('status').val() === 'active' && root.child('orgs').child($orgId).child('members').child(auth.uid).child('role').val() === 'employee') && root.child('orgs').child($orgId).child('mediaMetadata').child('staff').child($projectId).child($mediaId).exists() && root.child('orgs').child($orgId).child('mediaMetadata').child('staff').child($projectId).child($mediaId).child('createdBy').val() === auth.uid))"
              }
